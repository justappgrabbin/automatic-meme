<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#000000">
    <title>Causal Graph: Living Universe</title>

    <link rel="manifest" href="/manifest.json">

    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.10.0/dist/tf.min.js"></script>
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/hammer.js/2.0.8/hammer.min.js"></script>

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        :root {
            --universe: #00ff88;
            --human: #ff0044;
            --agent: #00ccff;
            --blend: #ffaa00;
            --causal: #aa00ff;
            --bg: #000;
        }
        
        html, body {
            width: 100%; height: 100%;
            background: var(--bg);
            color: #fff;
            font-family: 'Courier New', monospace;
            overflow: hidden;
            position: fixed;
            touch-action: none;          /* ← prevents iOS bounce/scroll fight */
        }
        
        #app {
            width: 100%; height: 100%;
            display: grid;
            grid-template-rows: auto 1fr auto;
        }
        
        /* … the rest of your styles remain unchanged … */
        
        #loading {
            position: fixed;
            inset: 0;
            background: #000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 3000;
            transition: opacity 0.6s ease;
        }
        
        #loading.hidden {
            opacity: 0;
            pointer-events: none;
        }
    </style>
</head>
<body>

<div id="loading">
    <div class="spinner"></div>
    <div id="loading-status" style="margin-top: 16px; font-size: 11px; color: var(--universe);">
        Initializing Causal Graph...
    </div>
    <div style="margin-top: 6px; font-size: 9px; color: #444;">
        This may take 10–40 seconds on first load
    </div>
</div>

<!-- the rest of your HTML structure (upload-overlay, app, panels, controls, file-input) stays exactly the same -->

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

// … your full CausalGraph class here, with these changes only …

class CausalGraph {
    constructor() {
        // … all properties same …
        this.loadLocalState = this.loadLocalState.bind(this); // just in case
    }

    async init() {
        await this.initPython();
        this.initScene();
        this.initUniverse();
        this.initHuman();
        this.initAgent();

        // Critical: load persisted state AFTER universe/bookshelf exists
        this.loadLocalState();

        this.startLoops();
        this.animate();

        log('Causal Graph initialized', 'system');
    }

    async initPython() {
        try {
            // Progress feedback
            document.getElementById('loading-status').textContent = "Downloading Python runtime (\~8 MB)…";

            this.pyodide = await loadPyodide();

            document.getElementById('loading-status').textContent = "Installing numpy…";

            await this.pyodide.loadPackage(['numpy']);

            document.getElementById('loading-status').textContent = "Python engine ready. Building universe…";

            // … your runPythonAsync block remains unchanged …

            log('Python engine loaded', 'system');
        } catch (e) {
            log('Python error: ' + e.message, 'error');
            document.getElementById('loading-status').textContent = "Failed to load Python. Check console.";
        }
    }

    initScene() {
        // … same …
        this.renderer = new THREE.WebGLRenderer({ antialias: true });
        this.renderer.setSize(window.innerWidth, window.innerHeight);
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // ← mobile battery saver
        this.renderer.shadowMap.enabled = true;
        document.getElementById('canvas-container').appendChild(this.renderer.domElement);
        // … rest same …
    }

    // … rest of class methods unchanged except loadLocalState stays as-is …
}

// Global init with overlay close fix
async function init() {
    causalGraph = new CausalGraph();
    await causalGraph.init();
    
    document.getElementById('loading').classList.add('hidden');
    setTimeout(() => {
        document.getElementById('loading').style.display = 'none';
    }, 600); // match fade duration

    document.getElementById('app').style.display = 'grid';
    
    const fileInput = document.getElementById('file-input');
    fileInput.addEventListener('change', (e) => {
        Array.from(e.target.files).forEach(file => causalGraph.handleFile(file));
        // Close overlay after selection
        document.getElementById('upload-overlay').classList.remove('visible');
    });

    // … drop zone listeners same …

    // Service worker — relative path for Vercel/Netlify safety
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('./service-worker.js')
                .then(() => console.log('Service Worker registered'))
                .catch(err => console.warn('Service Worker failed:', err));
        });
    }
}

// … all your global functions (setMode, togglePanel, etc.) stay the same …

init();
</script>

</body>
</html>
